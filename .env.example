# ---------------------------------------------------------------------------
# Docker Compose configuration.
# Copy to `.env` in this directory before running `docker compose up`.
# For plain npm development, use server/.env and web/.env.local instead.
# ---------------------------------------------------------------------------

# Ports published on the host
WEB_PORT=3000
API_PORT=4000

# Public URLs. These must be what the *browser* sees — Google redirects the user
# back through them, so internal Docker hostnames will not work.
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# REQUIRED SECRETS
# Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
SESSION_SECRET=
# Encrypts OAuth tokens at rest. If you change this, every connected Gmail
# account must be reconnected.
ENCRYPTION_KEY=

# Set to true once you serve the app over HTTPS.
SECURE_COOKIES=false
SESSION_TTL_HOURS=12

# ---------------------------------------------------------------------------
# Optional: create the first dashboard login automatically on startup.
# Leave blank to create it in the browser on first visit.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Optional: seed Google OAuth credentials. These can also be entered in the
# dashboard, which stores them encrypted and takes precedence.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/google/callback

# Set to 1 when running behind nginx/Cloudflare so rate limiting sees real IPs.
TRUST_PROXY=
LOG_LEVEL=info
