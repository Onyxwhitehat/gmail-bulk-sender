# ---------------------------------------------------------------------------
# Server configuration
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Public URL of the dashboard (used for CORS + post-OAuth redirects)
APP_URL=http://localhost:3000
# Public URL of this API (used to build the default OAuth redirect URI)
API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Secrets — REQUIRED in production.
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
# Signs dashboard session cookies.
SESSION_SECRET=
# Encrypts OAuth refresh tokens and the Google client secret at rest.
# WARNING: changing this makes every stored token undecryptable — you would have
# to reconnect each Gmail account.
ENCRYPTION_KEY=

SESSION_TTL_HOURS=12
# Set to true when serving over HTTPS so cookies get the Secure flag.
SECURE_COOKIES=false

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_FILE=./data/app.db

# ---------------------------------------------------------------------------
# First-run admin (optional).
# If set, this dashboard login is created automatically on first boot.
# Leave blank to create it through the browser instead.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Google OAuth (optional here — these can also be set in the dashboard UI,
# which stores them encrypted in the database and takes precedence).
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/google/callback

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
# Number of reverse proxies in front of the app (or `true` for one).
# Leave blank when there is no proxy — trusting the header lets clients spoof IPs.
TRUST_PROXY=
LOG_LEVEL=debug
